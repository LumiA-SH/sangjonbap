NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

AUTH_PROVIDER=dev
DATA_MODE=supabase

DEV_LOGIN_KEY=개발비밀번호
DEV_AUTH_USER_ID=1

DATABASE_URL=DB URL

DATABASE_CA_PATH=

# OAuth: set AUTH_PROVIDER=mastodon, FRONTEND_ORIGIN=https://survivalbob.site,
# DATA_MODE=supabase. Secrets belong in server/.env or the deployment secret store.
# Do not put these in REACT_APP_* variables. Leave blank until app registration.
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_REDIRECT_URI=https://survivalbob.site/api/auth/mastodon/callback
